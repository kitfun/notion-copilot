# Public build config for the hosted Notico. None of these are secrets.
# Override any of them in .env.local (git-ignored) to point at your own deployment.

# Clerk publishable key (Clerk Dashboard > API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuY29mdW4uY2Mk

# Web page where users sign in (served by the worker). Clerk syncs its session into the extension:
# from this host on a development instance, from the Frontend API host on a production one.
VITE_CLERK_SYNC_HOST=https://api.cofun.cc

# Worker base URL, including /v1
VITE_API_URL=https://api.cofun.cc/v1

# Product analytics (src/analytics.ts): PostHog's ingestion host (US region), and the project's key
# (PostHog > Settings > Project > Project API key, phc_…), which is public by design. Usage events
# are sent only when both are set.
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_KEY=phc_gO1i2DKlg9TOf0mme2DKkZ0EezWMZ0yNjXOFTDhBaNu

# The public key the Chrome Web Store gave Notico (Package tab). Development builds load
# with the store's extension ID, the one Clerk and the worker allow. To use your own,
# see docs/development.md.
CRX_PUBLIC_
